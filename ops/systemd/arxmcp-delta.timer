[Unit]
# E11_S02 — Nightly trigger for arxmcp-delta.service.
#
# Fires at 02:00 daily. The 02:00 slot matches the project's
# daily ops cadence documented in
# .claude/notes/08-security-observability-ops.md (OAI-PMH window
# starts at 00:00 UTC; pipeline writes by 04:00; restic at 04:10).
Description=arXMCP OAI-PMH delta loop — nightly schedule
Documentation=file:/etc/arxmcp/docs/ops/delta-loop.md

[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true
Unit=arxmcp-delta.service
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
