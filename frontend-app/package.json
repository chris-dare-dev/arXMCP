{
  "name": "arxmcp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "arXMCP operator console SPA (WS-B). Built by Vite at build time; served as static dist/ at /app by the FastAPI process. No Node at runtime.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts && node scripts/stamp-api-hash.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/stix-two-math": "^5.2.1",
    "@fontsource/stix-two-text": "^5.2.8",
    "3d-force-graph": "^1.80.0",
    "animejs": "^4.5.0",
    "katex": "^0.17.0",
    "motion": "^12.42.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
