# Per-user Claude state (machine-local; not for the repo)
.claude/settings.local.json
.claude/worktrees/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Build / runtime artifacts (paths anticipated by the design notes)
# CLAUDE.md section 5 describes the WHOLE of var/ as the gitignored data tree,
# but this pattern only ever covered var/arxmcp/ -- so ingest staging trees
# (var/fourier-staging/, var/textbook-staging/, ~93 MB of source PDFs) and the
# loose driver scripts beside them showed up as untracked noise on every
# status, and were one `git add .` away from being committed. Widened to all
# of var/ to match the documented intent. Nothing under var/ has ever been
# tracked (`git ls-files var/` is empty), so this changes no history.
/var/
*.log
*.egg-info/

# E11_S05 — restic creds. The .template is committed; the filled
# file with the operator's RESTIC_REPOSITORY / B2 creds is not.
ops/restic-env.sh

# E13_S06 — SBOM JSON outputs. The raw CycloneDX files are multi-MB
# and timestamped per run; the audit doc references the procedure
# (``make sbom``) rather than committing the artifacts directly.
# A future release-tag milestone may flip this to commit only the
# tag's signed SBOM.
.claude/docs/security/sbom/*.json
.claude/docs/security/sbom/*.cdx.json

# Codex (OpenAI agent tool) working artifacts — ephemeral, per-session scratch.
# arXMCP's agent instructions live in CLAUDE.md; these are local codex state and
# must not enter git. `.agents/` showed up as a stray, divergent skill mirror
# (NOT written by sync-repos.py, which targets .claude/skills/); `.codex/` is the
# codex session dir. (AGENTS.md is left tracked-eligible — decide per-repo whether
# to author it as codex instructions or ignore it.)
.agents/
.codex/
