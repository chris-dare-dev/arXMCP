# syntax=docker/dockerfile:1.7
#
# arxmcp-server runtime image (E06_S01).
#
# Multi-stage build:
#   1. ``builder``  — full Python toolchain; builds a wheel from the
#                     project source (NOT an editable install — see
#                     IS1 close from the E06_S01 critique).
#   2. ``runtime``  — slim Python image; installs the wheel into a
#                     dedicated venv, drops to a non-root user,
#                     installs ``tini`` as PID 1, exposes 7733, and
#                     starts the server via ``python -m server.main``
#                     so the ARXMCP_* env vars are honored (IS3+IS4
#                     close).
#
# Threat 6 (``08-security-observability-ops.md``): we use safetensors-
# only model loading and the BGE-M3 commit SHA pinned in
# ``ingest/embedder.py``.
#
# Run with:
#
#   docker build -f docker/Dockerfile.server -t arxmcp-server:dev .
#   docker run --rm -p 127.0.0.1:7733:7733 \
#     -v "$PWD/var/arxmcp:/app/var/arxmcp" arxmcp-server:dev
#
# Out of scope per the brief: the docker-compose file (lands in E06_S05).

# ---------------------------------------------------------------------------
# Stage 1 — builder (build the project wheel)
# ---------------------------------------------------------------------------

# Base image pinned by @sha256 digest (notebook-ops-hardening-m3). A tag
# alone is mutable — Docker Hub allows `3.11-slim` to be overwritten — so a
# compromised builder or upstream push could silently land on a rebuild.
# This is the multi-arch manifest-list digest (amd64 + arm64/Apple Silicon
# both resolve), mirroring the @sha256 discipline in
# infra/observability/phoenix-compose.yml and 08-security-observability-ops.md
# §Threat 6 (pin by SHA). Re-resolve on a deliberate bump with:
#   docker buildx imagetools inspect python:3.11-slim
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build deps for compiled wheels (torch, pyarrow). ``--no-install-recommends``
# keeps the layer minimal.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy the dep manifest first so dep-install layer caches across
# source edits.
COPY pyproject.toml README.md ./

# Then copy the source tree (this layer changes on every commit).
COPY server/ ./server/
COPY ingest/ ./ingest/
COPY tools/ ./tools/
# shim/ is a declared setuptools package (the arxmcp-shim console-script,
# E06_S02). Without it in the build context the wheel build fails with
# "package directory 'shim' does not exist".
COPY shim/ ./shim/
# ops/ is a declared setuptools package too (issue #206). EVERY directory
# named in pyproject.toml's ``[tool.setuptools.packages.find] include`` list
# must be in the build context or the wheel build fails outright ("package
# directory 'ops' does not exist") — these COPY lines and that include list
# are one contract, so adding a tree there means adding a line here.
# tests/test_wheel_packaging.py asserts the pairing.
#
# ops/ carries the operability layer the docs/ops/ runbooks invoke: backup,
# cutover, restore drill, drift watchdog. Before issue #206 it was in
# neither the wheel nor the image, so an operator following the documented
# compose path had no backup and no restore drill, with nothing announcing
# their absence.
COPY ops/ ./ops/
# NOTE no ``COPY frontend/``. The operator-console templates and vendored
# htmx/CSS moved to ``server/frontend/`` before the first PyPI publish (a
# top-level ``frontend`` package claims that generic name in every
# installing environment's site-packages), so the ``COPY server/`` above
# already carries them. Nothing else is needed here.

# IS1 close: build a wheel rather than ``pip install -e .``. The
# editable install bakes ``/build`` into the venv's .pth file; when
# the runtime stage moves the source to ``/app``, imports break.
# A wheel is path-independent and survives the stage transition.
# We also pre-install the runtime deps into ``/opt/venv`` here so
# the runtime stage just needs to install the project wheel.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip wheel build \
    && /opt/venv/bin/pip install . \
    && /opt/venv/bin/pip wheel --no-deps --wheel-dir /wheels .

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------

# Pinned by @sha256 digest — see the builder-stage rationale above
# (notebook-ops-hardening-m3). Keep both stages on the SAME digest.
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# ``tini`` as PID 1 so SIGTERM reaches the server entry point and the
# lifespan shutdown drain (30 s budget) runs cleanly. Pure-Python
# urllib could replace ``curl`` at the cost of slightly slower
# probes (acceptable for a 30 s healthcheck cadence) — kept ``curl``
# for now per IS8's ship-as-is recommendation.
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Non-root user (UID 1000). Threat 3 mitigations.
RUN groupadd --gid 1000 arxmcp \
    && useradd --uid 1000 --gid arxmcp --shell /bin/bash --create-home arxmcp

WORKDIR /app

# Copy the populated venv + the project wheel from the builder.
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /wheels /wheels

# Install the project wheel (IS1 close). Path-independent — the
# venv now resolves ``import server.*`` from inside site-packages,
# not from the source tree. The source tree COPY below is for
# in-container debugging / inspection only.
RUN /opt/venv/bin/pip install --no-cache-dir --no-deps /wheels/*.whl \
    && rm -rf /wheels

# Source tree for in-container inspection (NOT used for imports).
COPY server/ ./server/
COPY ingest/ ./ingest/
COPY pyproject.toml README.md ./

# Operator-console assets need no COPY of their own: they live at
# ``server/frontend/`` (moved there before the first PyPI publish, issue
# #195 follow-up), so the ``COPY server/`` above carries them and the wheel
# installed below carries them into site-packages. Both call sites resolve
# the assets relative to the ``server`` PACKAGE rather than a repo root,
# which is what lets the source-tree and installed layouts stay
# interchangeable.

# ops/: the operability layer (issue #206) — ops/cutover.sh,
# ops/restore_drill.sh, ops/drift_check.py, ops/checkpoint_notebooks_db.py,
# ops/watchdog_eval.py plus the cron/ and systemd/ units. Unlike the copies
# above this one is NOT merely for inspection: every runbook under
# docs/ops/ tells the operator to invoke these paths inside the container
# (`docker exec ... ops/restore_drill.sh`), and the systemd/cron units are
# meant to be read out and installed on the host. The wheel carries them
# into site-packages, but at a path no runbook names.
COPY ops/ ./ops/

# Create the var/arxmcp tree. IS6: scope chown to /app/var only —
# source tree stays root-owned (still readable to ``arxmcp``).
RUN mkdir -p /app/var/arxmcp/index/lancedb \
            /app/var/arxmcp/corpus/chunks \
            /app/var/arxmcp/ops \
    && chown -R arxmcp:arxmcp /app/var

# IS7: declare the writable mount point for the read-only-FS posture
# operators may want at deploy time (``docker run --read-only -v
# .../var/arxmcp:/app/var/arxmcp``).
VOLUME /app/var/arxmcp

USER arxmcp

EXPOSE 7733

# IS5 partial fix: 5-minute start-period covers a fresh BGE-M3
# download on a typical home broadband (~2.3 GB safetensors). Warm
# HF caches still complete in ~5 s. Operators on faster links can
# tighten this via deployment manifests; the in-image default
# matches the worst-case first-run path.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5m --retries=3 \
    CMD curl -fsS http://127.0.0.1:7733/readyz || exit 1

# tini handles signal forwarding to the server entry point so
# ``docker stop`` triggers the FastAPI lifespan shutdown drain.
ENTRYPOINT ["/usr/bin/tini", "--"]

# IS3+IS4 fix: invoke ``python -m server.main`` (which honors
# ARXMCP_BIND_HOST / ARXMCP_BIND_PORT via Config) rather than
# hardcoding ``--host`` / ``--port`` on a uvicorn CLI. Operators
# overriding the bind via ``-e ARXMCP_BIND_PORT=7700`` get the
# server bound at the override.
CMD ["python", "-m", "server.main"]
