# syntax=docker/dockerfile:1.7
#
# arxmcp-server runtime image (E06_S01).
#
# Multi-stage build:
#   1. ``builder``  — full Python toolchain; installs the project and its
#                     compiled deps (torch, lancedb, pyarrow). The wheel
#                     cache is mounted via BuildKit so successive builds
#                     reuse pip's HTTP cache.
#   2. ``runtime``  — slim Python image; copies the populated venv from
#                     the builder, drops to a non-root user, installs
#                     ``tini`` as PID 1, exposes 7733, and starts uvicorn.
#
# Threat 6 (``08-security-observability-ops.md``): we use safetensors-only
# model loading and the BGE-M3 commit SHA pinned in
# ``ingest/embedder.py``. The reranker model (E07) honors the same
# discipline.
#
# Run with ``docker run --rm -p 127.0.0.1:7733:7733 \
#   -v "$PWD/var/arxmcp:/app/var/arxmcp" arxmcp-server:dev``.
#
# Out of scope per the brief: the docker-compose file (lands in E06_S05).

# ---------------------------------------------------------------------------
# Stage 1 — builder
# ---------------------------------------------------------------------------

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build deps for compiled wheels (torch, pyarrow). ``--no-install-recommends``
# keeps the layer minimal.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only the dep manifest first so dep-install layer caches across
# source edits.
COPY pyproject.toml ./

# Install into a venv we then copy whole into the runtime image.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -e .

# Now copy the source tree (this layer changes on every commit).
COPY server/ ./server/
COPY ingest/ ./ingest/
COPY tools/ ./tools/

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    ARXMCP_BIND_HOST=127.0.0.1 \
    ARXMCP_BIND_PORT=7733

# ``tini`` as PID 1 so SIGTERM reaches uvicorn and the lifespan
# shutdown drain (30 s budget) runs cleanly. ``curl`` for the
# HEALTHCHECK probe.
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Non-root user (UID 1000). Threat 3 mitigations.
RUN groupadd --gid 1000 arxmcp \
    && useradd --uid 1000 --gid arxmcp --shell /bin/bash --create-home arxmcp

WORKDIR /app

# Copy the venv built in stage 1 (full transitive deps, including the
# project installed in editable mode).
COPY --from=builder /opt/venv /opt/venv

# Copy source tree and the in-tree project metadata.
COPY --from=builder /build/server ./server
COPY --from=builder /build/ingest ./ingest
COPY --from=builder /build/tools ./tools
COPY pyproject.toml README.md ./

# Create the var/arxmcp tree and chown to the non-root user. Operators
# bind-mount their own data over this at runtime.
RUN mkdir -p /app/var/arxmcp/index/lancedb \
            /app/var/arxmcp/corpus/chunks \
            /app/var/arxmcp/ops \
    && chown -R arxmcp:arxmcp /app

USER arxmcp

EXPOSE 7733

# 30-second health budget — well under uvicorn's default startup, but
# the eager BGE-M3 load can take longer on first run. Operators with
# slow model downloads should set ``--start-period=2m`` at deploy time.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:7733/readyz || exit 1

# tini handles signal forwarding to uvicorn so ``docker stop`` triggers
# the FastAPI lifespan shutdown drain.
ENTRYPOINT ["/usr/bin/tini", "--"]

# uvicorn is a long-running process; the brief mandates single-worker
# (``workers=1``) because multi-worker would defeat the shared-cache
# semantics that make the long-running design correct in the first
# place.
CMD ["uvicorn", "server.main:app", \
     "--host", "127.0.0.1", \
     "--port", "7733", \
     "--lifespan", "on", \
     "--no-access-log"]
