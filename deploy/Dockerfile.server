# syntax=docker/dockerfile:1.7
#
# arxmcp-server runtime image (E06_S01).
#
# Multi-stage build:
#   1. ``builder``  — full Python toolchain; installs the dependency
#                     closure pinned in ``uv.lock`` (hash-checked) and
#                     builds a wheel from the project source (NOT an
#                     editable install — see IS1 close from the E06_S01
#                     critique).
#   2. ``runtime``  — slim Python image; installs the wheel into a
#                     dedicated venv, imports only from that venv's
#                     site-packages, drops to a non-root user,
#                     installs ``tini`` as PID 1, exposes 7733, and
#                     starts the server via ``python -m arxmcp.server.main``
#                     so the ARXMCP_* env vars are honored (IS3+IS4
#                     close).
#
# Threat 6 (``08-security-observability-ops.md``): we use safetensors-
# only model loading and the BGE-M3 commit SHA pinned in
# ``src/arxmcp/ingest/embedder.py``.
#
# Run with:
#
#   docker build -f deploy/Dockerfile.server -t arxmcp-server:dev .
#   docker run --rm -p 127.0.0.1:7733:7733 \
#     -v "$PWD/var/arxmcp:/app/var/arxmcp" arxmcp-server:dev
#
# Out of scope per the brief: the docker-compose file (lands in E06_S05).

# ---------------------------------------------------------------------------
# Stage 1 — builder (build the project wheel)
# ---------------------------------------------------------------------------

# Base image pinned by @sha256 digest (notebook-ops-hardening-m3). A tag
# alone is mutable — Docker Hub allows `3.11-slim` to be overwritten — so a
# compromised builder or upstream push could silently land on a rebuild.
# This is the multi-arch manifest-list digest (amd64 + arm64/Apple Silicon
# both resolve), mirroring the @sha256 discipline in
# deploy/observability/phoenix-compose.yml and 08-security-observability-ops.md
# §Threat 6 (pin by SHA). Re-resolve on a deliberate bump with:
#   docker buildx imagetools inspect python:3.11-slim
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build deps for compiled wheels (torch, pyarrow). ``--no-install-recommends``
# keeps the layer minimal.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv only reads the lockfile; it never reaches the runtime stage. Pinned by
# @sha256 digest for the same reason as the base image. Re-resolve on a
# deliberate bump with:
#   docker buildx imagetools inspect ghcr.io/astral-sh/uv:<version>
COPY --from=ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc /uv /usr/local/bin/uv

WORKDIR /build

# Copy the dep manifest and the lock first so the dependency layer caches
# across source edits.
COPY pyproject.toml uv.lock README.md ./

# The dependency closure comes from ``uv.lock``, not from a fresh resolve
# against the open ranges in pyproject.toml: two builds a month apart must
# get the same transformers / torch / lancedb, or an embedding or on-disk
# format can shift with no change in git, and ``make sbom`` describes one
# build rather than the build. ``--locked`` fails the build when the lock
# is stale against pyproject.toml instead of quietly re-resolving.
# ``--require-hashes`` plus ``--no-deps`` means pip installs exactly the
# exported set, each file checked against the hash in the lock, and
# nothing it would have resolved on its own. The project itself is left
# out here and installed from its wheel in the runtime stage.
RUN uv export --locked --no-dev --no-emit-project --format requirements.txt \
        --output-file /build/requirements.lock.txt \
    && python -m venv /opt/venv \
    && /opt/venv/bin/pip install --require-hashes --no-deps \
        -r /build/requirements.lock.txt

# Then copy the source tree (this layer changes on every commit). Every
# Python box lives under src/arxmcp, the one package pyproject declares, so
# this single COPY is the whole build context the wheel needs.
# tests/test_wheel_packaging.py asserts the pairing with pyproject.
COPY src/arxmcp/ ./src/arxmcp/

# IS1 close: build a wheel rather than ``pip install -e .``. The
# editable install bakes ``/build`` into the venv's .pth file; when
# the runtime stage moves the source to ``/app``, imports break.
# A wheel is path-independent and survives the stage transition.
# The runtime deps are already in ``/opt/venv`` from the locked layer
# above, so the runtime stage just installs the project wheel.
RUN /opt/venv/bin/pip wheel --no-deps --wheel-dir /wheels .

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------

# Pinned by @sha256 digest — see the builder-stage rationale above
# (notebook-ops-hardening-m3). Keep both stages on the SAME digest.
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS runtime

# PYTHONSAFEPATH stops ``python -m`` and ``python -c`` from putting the
# working directory (/app) ahead of site-packages, so ``ops/`` below can
# never shadow the installed package of the same name.
#
# ARXMCP_DATA_DIR is explicit because the server only falls back to
# ``<checkout>/var/arxmcp`` when it runs from a source checkout. An
# installed wheel would otherwise pick the platform data directory under
# the user's home, outside the declared volume.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONSAFEPATH=1 \
    ARXMCP_DATA_DIR=/app/var/arxmcp \
    PATH="/opt/venv/bin:$PATH"

# ``tini`` as PID 1 so SIGTERM reaches the server entry point and the
# lifespan shutdown drain (30 s budget) runs cleanly. Pure-Python
# urllib could replace ``curl`` at the cost of slightly slower
# probes (acceptable for a 30 s healthcheck cadence) — kept ``curl``
# for now per IS8's ship-as-is recommendation.
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Non-root user (UID 1000). Threat 3 mitigations.
RUN groupadd --gid 1000 arxmcp \
    && useradd --uid 1000 --gid arxmcp --shell /bin/bash --create-home arxmcp

WORKDIR /app

# Copy the populated venv + the project wheel from the builder.
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /wheels /wheels

# Install the project wheel (IS1 close). This is the only copy of
# ``server``, ``ingest``, ``tools`` and ``shim`` in the image: there is no
# source tree beside it to import from instead, so a data file missing
# from the wheel fails here or at boot rather than being papered over.
# ``pip check`` fails the build if the locked closure does not satisfy the
# wheel's declared requirements.
RUN /opt/venv/bin/pip install --no-cache-dir --no-deps /wheels/*.whl \
    && rm -rf /wheels \
    && /opt/venv/bin/pip check

# ops/: the operability layer (issue #206) — src/arxmcp/ops/cutover.sh,
# src/arxmcp/ops/restore_drill.sh, src/arxmcp/ops/drift_check.py, src/arxmcp/ops/checkpoint_notebooks_db.py,
# src/arxmcp/ops/watchdog_eval.py plus the cron/ and systemd/ units. Unlike the copies
# above this one is NOT merely for inspection: every runbook under
# docs/ops/ tells the operator to invoke these paths inside the container
# (`docker exec ... src/arxmcp/ops/restore_drill.sh`), and the systemd/cron units are
# meant to be read out and installed on the host. The wheel carries them
# into site-packages, but at a path no runbook names. Python code still
# imports ``ops`` from site-packages (PYTHONSAFEPATH above); these files
# are the scripts and units an operator reads or runs by path.
COPY src/arxmcp/ops/ ./src/arxmcp/ops/

# Every shipped package must resolve from the venv, never from /app.
RUN python -c "import importlib.util, sys; \
bad = {n: importlib.util.find_spec(n).origin \
       for n in ('arxmcp', 'arxmcp.settings', 'arxmcp.server', 'arxmcp.ingest', 'arxmcp.tools', 'arxmcp.shim', 'arxmcp.ops') \
       if not (importlib.util.find_spec(n).origin or '').startswith('/opt/venv/')}; \
sys.exit(f'imports resolve outside /opt/venv: {bad}' if bad else 0)"

# The pinned arxiv CA bundle ships inside the wheel as src/arxmcp/settings/ca/ package
# data. Building the pinned context from the installed copy proves
# ARXMCP_PIN_ARXIV_CA=1 can start in this image.
RUN ARXMCP_PIN_ARXIV_CA=1 python -c "import sys; \
from arxmcp.settings import arxiv_ssl_context_from_env; \
sys.exit(0 if arxiv_ssl_context_from_env() else 'pinned arxiv CA context did not build')"

# Create the var/arxmcp tree. IS6: scope chown to /app/var only —
# source tree stays root-owned (still readable to ``arxmcp``).
RUN mkdir -p /app/var/arxmcp/index/lancedb \
            /app/var/arxmcp/corpus/chunks \
            /app/var/arxmcp/ops \
    && chown -R arxmcp:arxmcp /app/var

# IS7: declare the writable mount point for the read-only-FS posture
# operators may want at deploy time (``docker run --read-only -v
# .../var/arxmcp:/app/var/arxmcp``).
VOLUME /app/var/arxmcp

USER arxmcp

EXPOSE 7733

# IS5 partial fix: 5-minute start-period covers a fresh BGE-M3
# download on a typical home broadband (~2.3 GB safetensors). Warm
# HF caches still complete in ~5 s. Operators on faster links can
# tighten this via deployment manifests; the in-image default
# matches the worst-case first-run path.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5m --retries=3 \
    CMD curl -fsS http://127.0.0.1:7733/readyz || exit 1

# tini handles signal forwarding to the server entry point so
# ``docker stop`` triggers the FastAPI lifespan shutdown drain.
ENTRYPOINT ["/usr/bin/tini", "--"]

# IS3+IS4 fix: invoke ``python -m arxmcp.server.main`` (which honors
# ARXMCP_BIND_HOST / ARXMCP_BIND_PORT via Config) rather than
# hardcoding ``--host`` / ``--port`` on a uvicorn CLI. Operators
# overriding the bind via ``-e ARXMCP_BIND_PORT=7700`` get the
# server bound at the override.
CMD ["python", "-m", "arxmcp.server.main"]
