{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:arxmcp:bridge:corpus-snapshot:v1",
  "title": "arxmcp.bridge/corpus-snapshot v1",
  "description": "What /status knows, frozen at a moment: notebooks + corpus versions + counts - the machine-checkable answer to 'what substrate am I talking to'. Server-scoped: substrate.notebook / corpus_version / filter_echo are null (this is the one core type that exercises the envelope's null branch). Producer: arXMCP server. Consumer: anyone.",
  "x-bridge": {
    "artifact": "arxmcp.bridge/corpus-snapshot",
    "version": "1.0",
    "status": "stable"
  },
  "allOf": [
    { "$ref": "urn:arxmcp:bridge:envelope:v1" },
    {
      "properties": {
        "bridge": {
          "properties": {
            "artifact": { "const": "arxmcp.bridge/corpus-snapshot" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["captured_at", "notebooks"],
          "properties": {
            "captured_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "notebooks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slug", "corpus_version", "paper_count", "chunk_count"],
                "properties": {
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "corpus_version": { "type": "integer", "minimum": 0 },
                  "paper_count": { "type": "integer", "minimum": 0 },
                  "chunk_count": { "type": "integer", "minimum": 0 },
                  "marker_created_at": {
                    "description": "created_at of the corpus-version marker this row was read from.",
                    "type": "string"
                  },
                  "embedder": { "type": "string" },
                  "chunker_version": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
